# Default deny. Reopen source directories and explicitly permit source files.
*

!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/docs/
!/docs/*.md
!/docs/figures/
!/docs/figures/reference-die-layouts.svg
