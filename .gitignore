!/src/
!/src/**/
!/src/**/*.py
!/src/emulateqpu/schemas/*.json
!/src/emulateqpu/examples/*.json
!/src/emulateqpu/_physics/configs/*.json
!/tests/
!/tests/**/
!/tests/**/*.py
!/LICENSES/
!/LICENSES/*.txt
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/CONTRIBUTING.md
!/LICENSE.md
!/MANIFEST.in
!/NOTICE
!/README.md
!/requirements-reference.txt
!/THIRD_PARTY.md
!/justfile
!/pyproject.toml
!/uv.lock

__pycache__/
*.egg-info/

!/reproducibility/
