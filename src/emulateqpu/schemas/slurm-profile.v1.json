{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emulateqpu:schema:slurm-profile.v1.json",
  "type": "object",
  "required": ["shared_filesystem"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "emulateqpu.slurm_profile.v1"},
    "shared_filesystem": {"const": true},
    "shared_root": {"type": "string"},
    "python": {"type": "string"},
    "partition": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "account": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "qos": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "job_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "memory_mb": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "cpus_per_task": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_array_size": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 1001, "description": "Maximum elements in one shard. Set to the smaller of the site's MaxArraySize and max_array_tasks limits."},
    "array_concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
    "wall_time": {"type": "string", "pattern": "^([0-9]+-)?[0-9]{1,3}:[0-9]{2}:[0-9]{2}$"},
    "dependency": {"type": "string", "pattern": "^(afterok|afterany|afternotok):[0-9]+(:[0-9]+)*$"},
    "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "additionalProperties": {"type": "string"}}
  },
  "$comment": "The application additionally validates positive wall time, absolute shared paths, single-thread environment and detected site allocations."
}
