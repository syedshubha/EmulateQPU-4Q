{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emulateqpu:schema:result.v1.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emulateqpu.result.v1"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "NOT_APPLICABLE",
        "CHECKPOINTED"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "request_sha256": {
      "type": "string"
    },
    "payload_sha256": {
      "type": "object"
    },
    "scientific_qualification": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "status",
    "complete",
    "request_sha256",
    "scientific_qualification"
  ],
  "additionalProperties": true
}
